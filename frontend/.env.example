# Fastify recommendation backend (repo `backend/`). Read server-side only.
BACKEND_URL=http://127.0.0.1:3001

# Google Maps JavaScript API. 需啟用 Maps JavaScript API，並在 Console 限制 HTTP referrer。
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Advanced Marker 需要 Map ID；沒有自訂樣式時可留空，程式會用 DEMO_MAP_ID。
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
