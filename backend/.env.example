NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/home_selector
EMBEDDING_MODE=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
DETAIL_EXTRACTION_MODE=auto
DETAIL_EXTRACTION_MODEL=
DETAIL_EXTRACTION_BASE_URL=
DETAIL_EXTRACTION_API_KEY=
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=anjia-housing-agent/0.1 (+https://github.com/JoshHuang9508/DevJam2026)
NOMINATIM_EMAIL=
GEOCODE_BUDGET=250
GEOCODE_MIN_INTERVAL_MS=1100
PIPELINE_POLL_INTERVAL_MS=60000
PIPELINE_FETCH_TIMEOUT_MS=30000
REPOSITORY_MODE=memory
AGENT_MODE=pi
PI_PROVIDER=custom-openai
PI_MODEL=deepseek-flash
GEMINI_API_KEY=
# For PI_PROVIDER=custom-openai (DeepSeek official API example):
CUSTOM_OPENAI_BASE_URL=https://api.deepseek.com
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_MODEL_NAME=DeepSeek V4.1 Flash
CUSTOM_OPENAI_CONTEXT_WINDOW=1000000
CUSTOM_OPENAI_MAX_TOKENS=65536
CUSTOM_OPENAI_REASONING=true
CUSTOM_OPENAI_SUPPORTS_DEVELOPER_ROLE=false
CUSTOM_OPENAI_SUPPORTS_REASONING_EFFORT=true
CUSTOM_OPENAI_SUPPORTS_USAGE_IN_STREAMING=false
CUSTOM_OPENAI_SUPPORTS_STRICT_MODE=false
# 都市計畫圖資（臺北市 UPIS / 新北市城鄉資訊平台 / 基隆市 UPGIS）。公開端點，不需要金鑰。
# SLOW 是給基隆的：同一個查詢實測過 0.2 秒也實測過 21 秒，長一點當緩衝。
URBAN_PLAN_TIMEOUT_MS=15000
URBAN_PLAN_SLOW_TIMEOUT_MS=45000
URBAN_PLAN_CACHE_TTL_MS=86400000
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1048576
RATE_LIMIT_MAX=60
