NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/home_selector
REPOSITORY_MODE=postgres
AGENT_MODE=auto
PI_PROVIDER=google
PI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# For PI_PROVIDER=custom-openai:
CUSTOM_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
CUSTOM_OPENAI_API_KEY=pwd
CUSTOM_OPENAI_MODEL_NAME=GPT 5.6 Terra (local proxy)
CUSTOM_OPENAI_CONTEXT_WINDOW=128000
CUSTOM_OPENAI_MAX_TOKENS=32000
CUSTOM_OPENAI_REASONING=false
CUSTOM_OPENAI_SUPPORTS_DEVELOPER_ROLE=false
CUSTOM_OPENAI_SUPPORTS_REASONING_EFFORT=false
CUSTOM_OPENAI_SUPPORTS_USAGE_IN_STREAMING=false
CUSTOM_OPENAI_SUPPORTS_STRICT_MODE=false
# 都市計畫圖資（臺北市 UPIS / 新北市城鄉資訊平台 / 基隆市 UPGIS）。公開端點，不需要金鑰。
# SLOW 是給基隆的：同一個查詢實測過 0.2 秒也實測過 21 秒，長一點當緩衝。
URBAN_PLAN_TIMEOUT_MS=15000
URBAN_PLAN_SLOW_TIMEOUT_MS=45000
URBAN_PLAN_CACHE_TTL_MS=86400000
CORS_ORIGINS=http://localhost:3000
REQUEST_BODY_LIMIT=1048576
RATE_LIMIT_MAX=60
